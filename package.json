{
  "name": "injury-time",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "grid": "tsx scripts/grid.ts",
    "seed": "tsx scripts/seed.ts",
    "test:e2e": "playwright test",
    "verify": "vitest run && playwright test",
    "grid:squad-match": "tsx scripts/grid-squad-match.ts",
    "db:probe": "bash -c 'eval \"$(scripts/db/local.sh)\" && tsx scripts/rls-probe.ts'",
    "test:sw": "playwright test -c playwright.sw.config.ts",
    "grid:card-fit": "tsx scripts/grid-card-fit.ts",
    "test:e2e:local": "scripts/stack/e2e.sh",
    "verify:local": "vitest run && npm run db:probe && npm run grid:squad-match && npm run grid:card-fit && npm run test:sw && scripts/stack/e2e.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
